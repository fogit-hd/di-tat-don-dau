# Ứng dụng dùng DATABASE_URL. Prisma migrate dùng DIRECT_URL.
# Máy local (docker compose): hai URL trỏ cùng Postgres.
DATABASE_URL=postgresql://chip:chip@127.0.0.1:54329/chipgame?schema=public
DIRECT_URL=postgresql://chip:chip@127.0.0.1:54329/chipgame?schema=public

# Supabase: app đi transaction pooler (cổng 6543, pgbouncer=true).
# Migration và seed đi session pooler (cùng host, cổng 5432). Không dùng db.PROJECT.supabase.co.
# Dùng chung project sẵn có: thêm schema=ditatdondau vào CẢ HAI url. Bỏ tham số thì bảng ở public.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=ditatdondau
# DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=ditatdondau

# 1 = container chạy seed sau migrate, mỗi lần khởi động. Seed upsert, chạy lại không tạo bản ghi trùng.
# SEED_ON_BOOT=1

# Project Supabase miễn phí ngủ sau khoảng một tuần không có truy vấn.
# Backend gửi SELECT 1 theo chu kỳ này. Mặc định bật, 18 giờ. Cho phép 12–24. Tắt: DB_KEEPALIVE=0
# DB_KEEPALIVE=1
# DB_KEEPALIVE_HOURS=18

# Addon Postgres của Northflank chỉ cần DATABASE_URL.
# Container tự gán DIRECT_URL = DATABASE_URL khi DIRECT_URL trống.
# Seed đọc DIRECT_URL (nếu có) để không đi qua transaction pooler.

PORT=4607
# Origin được phép. Mặc định trong code: https://neoforcelab.com và localhost cổng 4517, 4607.
# Nhiều origin cách nhau bởi dấu phẩy. Không có đường dẫn, không có dấu / cuối.
CORS_ORIGINS=https://neoforcelab.com,http://localhost:4517,http://127.0.0.1:4517,http://localhost:4607,http://127.0.0.1:4607

# Bắt buộc nếu muốn POST /api/content/reload. Để trống thì đường đó trả 404.
CONTENT_RELOAD_TOKEN=dev-reload
